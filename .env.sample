# TermBridge configuration
# Copy this file to .env and adjust values for local development.

# API server bind address and port.
TERMBRIDGE_API_HOST=localhost
TERMBRIDGE_API_PORT=9008

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
TERMBRIDGE_LOGGING_LEVEL=INFO

# Enable uvicorn access logs in addition to TermBridge request logs.
TERMBRIDGE_UVICORN_ACCESS_LOG=false

# Maximum number of request/response body characters to include in logs.
TERMBRIDGE_BODY_LOG_LIMIT=4096

# Terminal HTTP proxy timeout.
TERMBRIDGE_TERMINAL_PROXY_TIMEOUT_SECONDS=10

# API bind address used for managed terminal session port availability checks.
TERMBRIDGE_HOST=127.0.0.1
TERMBRIDGE_PORT_START=19001
TERMBRIDGE_PORT_END=19999

# Local state directory. Source checkouts default to .termbridge when unset.
TERMBRIDGE_STATE_DIR=.termbridge

# Web static file serving. Leave TERMBRIDGE_WEB_DIR empty to use packaged static files.
TERMBRIDGE_SERVE_WEB=true
TERMBRIDGE_WEB_DIR=

# Timeout for terminating managed child processes.
TERMBRIDGE_PROCESS_SHUTDOWN_TIMEOUT_SECONDS=5

# Timeout for tmux commands that create/check workspace sessions and windows.
# Cygwin tmux cold starts can exceed 5 seconds, so the default is 10 seconds.
TERMBRIDGE_TMUX_COMMAND_TIMEOUT_SECONDS=10

# ttyd bind interface for managed terminal sessions.
# Defaults to 127.0.0.1 so ttyd child processes are not exposed on all network interfaces.
TERMBRIDGE_TTYD_INTERFACE=127.0.0.1

# Whether ttyd should allow terminal input.
TERMBRIDGE_TTYD_WRITABLE=true

# ttyd Basic Authentication mode: basic or none.
# basic protects ttyd with --credential. Empty password generates and stores a per-session password.
TERMBRIDGE_TTYD_CREDENTIAL_MODE=basic
TERMBRIDGE_TTYD_CREDENTIAL_USERNAME=termbridge
TERMBRIDGE_TTYD_CREDENTIAL_PASSWORD=

# ttyd child process log mode: file, console, or none.
# file writes stdout/stderr to logs/ttyd/<session-id>.log in source/editable installs,
# or .termbridge/logs/ttyd/<session-id>.log after wheel/regular installs.
# console keeps ttyd output attached to the parent process.
# none discards ttyd output.
TERMBRIDGE_TTYD_LOG_MODE=none
