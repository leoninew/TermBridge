# TermBridge configuration
# Copy this file to .env and adjust values for local development.

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
TERMBRIDGE_LOGGING_LEVEL=INFO

# API bind address and session port allocation range
TERMBRIDGE_HOST=127.0.0.1
TERMBRIDGE_PORT_START=19001
TERMBRIDGE_PORT_END=19999

# Local state directory. Source checkouts default to .termbridge when unset.
TERMBRIDGE_STATE_DIR=.termbridge

# Timeout for tmux commands that create/check workspace sessions and windows.
# Cygwin tmux cold starts can exceed 5 seconds, so the default is 10 seconds.
TERMBRIDGE_TMUX_COMMAND_TIMEOUT_SECONDS=10
